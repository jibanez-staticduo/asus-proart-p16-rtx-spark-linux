#!/usr/bin/bash
# Validate Linux image hashes and keep a usable P16 default after kernel updates.
set -euo pipefail
export PATH=/usr/bin:/bin
[[ $EUID == 0 ]] || exit 1
exec 9>/run/lock/boot-partition.lock
flock -x 9
menu=/boot/limine.conf
mapfile -t defaults < <(sed -n 's/^default_entry:[[:space:]]*//p' "$menu")
[[ ${#defaults[@]} == 1 ]] || { echo 'Expected one Limine default' >&2; exit 1; }
desired=${defaults[0]}
case $desired in
    Omarchy-P16|Omarchy-P16-Recovery|Omarchy/linux-p16-platform|Omarchy/linux-p16-platform-*) ;;
    *) echo "Unmanaged default preserved: $desired"; exit 0 ;;
esac
# Emit the full entry name beside each image. Never remove unrelated entries.
view=$(mktemp)
tmp=$(mktemp /boot/.p16-limine.XXXXXX)
trap 'rm -f -- "$view" "$tmp"' EXIT
awk '
  /^[[:space:]]*\// {
    line=$0; sub(/^[[:space:]]*/, "", line)
    depth=0; while (substr(line, depth+1, 1)=="/") depth++
    title=substr(line, depth+1); sub(/^\+/, "", title); sub(/[[:space:]]+$/, "", title)
    part[depth]=title; name=part[1]
    for (i=2; i<=depth; i++) name=name "/" part[i]
  }
  index($0, "boot():/EFI/Linux/") {
    for (i=1; i<=NF; i++) if (index($i, "boot():/EFI/Linux/")==1) print name "\t" $i
  }
' "$menu" > "$view"
selected_valid=false
recovery_valid=false
hashes_ok=true
selected_count=0
recovery_count=0
while IFS=$'\t' read -r entry token; do
    [[ $token =~ ^boot\(\):(/EFI/Linux/[^#[:space:]]+\.efi)\#([0-9a-fA-F]{128})$ ]] || exit 1
    path=${BASH_REMATCH[1]}; digest=${BASH_REMATCH[2]}
    resolved=$(realpath -m -- "/boot$path")
    [[ $resolved == /boot/EFI/Linux/* && $path != *..* ]] || exit 1
    valid=false
    actual=$(b2sum -- "$resolved" 2>/dev/null) || actual=missing
    [[ ${actual%% *} != "${digest,,}" ]] || valid=true
    if ! $valid; then
        echo "EFI image missing or hash mismatch: $path" >&2
        hashes_ok=false
    fi
    if [[ $entry == "$desired" ]]; then selected_count=$((selected_count + 1)); selected_valid=$valid; fi
    if [[ $entry == Omarchy-P16-Recovery ]]; then recovery_count=$((recovery_count + 1)); recovery_valid=$valid; fi
done < "$view"
[[ $selected_count == 1 && $recovery_count == 1 ]] || exit 1
if $selected_valid && [[ $desired == Omarchy/linux-p16-platform* ]]; then
    selected_path=$(awk -F '\t' -v name="$desired" '$1==name {print $2}' "$view")
    selected_path=${selected_path#boot\(\):}; selected_path=${selected_path%%#*}
    /usr/bin/p16-platform-update-check --image "/boot$selected_path" || selected_valid=false
fi
if ! $selected_valid; then
    $recovery_valid || { echo 'No validated recovery image; menu preserved' >&2; exit 1; }
    desired=Omarchy-P16-Recovery
    hashes_ok=false
fi
[[ $(grep -c '^timeout:' "$menu") == 1 ]] || exit 1
sed -e "s|^default_entry:.*|default_entry: $desired|" -e 's/^timeout:.*/timeout: 5/' "$menu" > "$tmp"
chmod --reference="$menu" "$tmp"
if ! cmp -s "$menu" "$tmp"; then mv -f "$tmp" "$menu"; sync -f /boot; fi
$hashes_ok || { echo "P16 default $desired; image validation failed" >&2; exit 1; }
echo "P16 default $desired; Linux image hashes valid"
