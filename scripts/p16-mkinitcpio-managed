#!/usr/bin/env bash
# Pacman's broad mkinitcpio triggers must not rewrite experimental P16 UKIs.
set -euo pipefail
export PATH=/usr/bin:/bin

[[ $EUID == 0 ]] || { echo 'Run as root.' >&2; exit 1; }
plan=false
if [[ ${1:-} == --plan ]]; then plan=true; fi
declare -A managed=()
# Only kernel packages in the maintained namespace participate. Recovery and
# unrelated kernels remain outside this wrapper, regardless of release number.
for base in /usr/lib/modules/*/pkgbase; do
  package=$(<"$base")
  [[ $package == linux-p16-platform || $package == linux-p16-platform-* ]] || continue
  pacman -Qq "$package" &>/dev/null || continue
  managed["$package"]=1
done

((${#managed[@]})) || { echo 'No managed Limine kernel found.' >&2; exit 1; }
declare -A selected=()
broad=false
while IFS= read -r target; do
  # ALPM's firmware glob includes parent directories as well as changed files.
  [[ -d /$target ]] && continue
  case $target in
    usr/lib/firmware/nvidia/n1x/*|usr/src/n1x-scp-*/dkms.conf|usr/src/n1x-pluton-*/dkms.conf|usr/src/n1x-adsp-*/dkms.conf|usr/src/n1x-sroot-provider-*/dkms.conf)
      # Late platform drivers are absent from stock/recovery initramfs images.
      for package in "${!managed[@]}"; do
        if [[ $package == linux-p16-platform || $package == linux-p16-platform-* ]]; then selected["$package"]=1; fi
      done
      ;;
    usr/lib/modules/*/modules.builtin|usr/lib/modules/*/pkgbase|usr/lib/modules/*/extramodules/*)
      path=${target#usr/lib/modules/}
      release=${path%%/*}
      package=$(pacman -Qqo "/usr/lib/modules/$release/modules.builtin" 2>/dev/null || true)
      if [[ -n $package && -n ${managed[$package]:-} ]]; then
        selected["$package"]=1
      fi
      ;;
    *) broad=true ;;
  esac
done

if $broad; then
  for package in "${!managed[@]}"; do selected["$package"]=1; done
fi
((${#selected[@]})) || { echo 'No managed kernel affected; experimental UKIs preserved.'; exit 0; }
mapfile -t packages < <(printf '%s\n' "${!selected[@]}" | sort)
echo "Rebuilding managed Limine kernels: ${packages[*]}"
if $plan; then exit 0; fi
# The kernel and headers must have completed DKMS installation before an image
# can replace a working managed P16 UKI. Stock kernels retain their own path.
for package in "${packages[@]}"; do
  for base in /usr/lib/modules/*/pkgbase; do
    [[ $(<"$base") == "$package" ]] || continue
    directory=${base%/pkgbase}
    if [[ $package == linux-p16-platform || $package == linux-p16-platform-* ]]; then
      /usr/bin/p16-platform-update-check --release "${directory##*/}"
    fi
  done
done
/usr/bin/limine-mkinitcpio "${packages[@]}"
# The Limine wrapper can succeed after an individual kernel build failed. It
# also deliberately keeps an identical UKI without changing its mtime, so
# validate the deployed file and its managed menu entry rather than freshness.
for package in "${packages[@]}"; do
  image="/boot/EFI/Linux/omarchy_${package}.efi"
  [[ -s $image ]] && grep -q "comment: kernel-id=${package} " /boot/limine.conf || {
    echo "Managed UKI or Limine entry is missing: $package" >&2
    exit 1
  }
  for base in /usr/lib/modules/*/pkgbase; do
    [[ $(<"$base") == "$package" ]] || continue
    directory=${base%/pkgbase}
    if [[ $package == linux-p16-platform || $package == linux-p16-platform-* ]]; then
      /usr/bin/p16-platform-update-check --image "$image" --release "${directory##*/}"
    fi
  done
done
