pkgname=hid-sensor-als-dkms
pkgver=0.1.0
pkgrel=2
pkgdesc='Upstream HID ALS driver with per-channel descriptor scales'
arch=('aarch64')
url='https://github.com/torvalds/linux/commit/cad928dad9a4c26aa56b4223dc2a29bca517fb5f'
license=('GPL-2.0-only')
depends=('dkms')
makedepends=('gcc' 'python')
source=('hid-sensor-als.c' 'hid-sensor-trigger.h' 'Kbuild' 'dkms.conf' 'provenance.json' 'README.md' 'test_scale.py')
sha256sums=('27c00f8565c943b541341d3db85c73deda3fabdbe3891a5b425a2ccd12c36e1a'
            '18310793a3daa6b470ba68646fa2984eef08ebc36170fad87c21aeca76aa7f88'
            '70e4330fd44c623838e58c8b6c904fe7295de7f5db0ebec939cad61d6fb1e5d8'
            'e988e9c43654d5e1ac021769446be71d7ff10009b34efd79ead5dcb9d515580f'
            '56ed407fc9b57716bf67c7b6f7a01a455fe7af8638b158602dd2b283d5da18ac'
            'ce782a10e7ec36446f0e902ee32f15a43a042aaa8fd2f3b42ec8e5b3af000860'
            '17309618c912472766be147971f8f54944e1322e88b27e7c01701572addf71b9')

check() {
  cd "$srcdir"
  python test_scale.py
}

package() {
  local file
  for file in hid-sensor-als.c hid-sensor-trigger.h Kbuild dkms.conf; do
    install -Dm644 "$srcdir/$file" "$pkgdir/usr/src/hid-sensor-als-$pkgver/$file"
  done
  install -Dm644 "$srcdir/provenance.json" "$pkgdir/usr/share/doc/$pkgname/provenance.json"
  install -Dm644 "$srcdir/README.md" "$pkgdir/usr/share/doc/$pkgname/README.md"
}
