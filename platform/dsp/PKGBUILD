pkgname=n1x-adsp-dkms
pkgver=0.1.0
pkgrel=2
pkgdesc='Experimental P16 MT8901 DSP secure-boot driver; firmware boot disabled'
arch=('aarch64')
url='https://github.com/johannhartmann/asus-proart-p16-rtx-spark-linux'
license=('GPL-2.0-only')
depends=('dkms')
optdepends=('n1x-sroot-provider-dkms: serialized SROOT upload API'
            'n1x-adsp-firmware-local: original signed images for explicit DSP boot')
checkdepends=('python' 'gcc')
source=('n1x_adsp.c' 'n1x_sroot_client.h' 'Kbuild' 'dkms.conf'
        'n1x-adsp.conf' 'provenance.json' 'README.md' 'test_driver.py')
sha256sums=('bf87ede132c8f51d0ed53e2712132a6b428a4c88d81c0f1754445e7f027e78e2'
            '97a563951b1d981b3a14f525f7bad0eaf33fe485a1f9352beb30af95148960f9'
            '230086b8afc95aea40727de3a89c05228cd79b78854e8973eefb06b65d740c02'
            'f2dc9530d03e6f0feb6f88815493aa79f6ba5866a7c01727798920ca89d9848b'
            '8beebbc715402c0bbea8120cbc29f2c601ade0c89589403d8aef6cc88cb56e36'
            'eef9440ccdb9cbc6d7a6b3e8752316e2af728dc40dff528e7e0229a916cb5d93'
            '47498eb83c7e8f119531b797e1c652d69efa16fa4b2fd63d4c22e37d5ccb0ba9'
            'b4b4968ff008d10d92b739fcfd733346262070f2df33ace05e28c90e0dadc201')

check() {
  cd "$srcdir"
  python test_driver.py
}

package() {
  local file
  for file in n1x_adsp.c n1x_sroot_client.h Kbuild dkms.conf provenance.json; do
    install -Dm644 "$srcdir/$file" "$pkgdir/usr/src/n1x-adsp-$pkgver/$file"
  done
  install -Dm644 "$srcdir/n1x-adsp.conf" "$pkgdir/usr/lib/modprobe.d/n1x-adsp.conf"
  install -Dm644 "$srcdir/README.md" "$pkgdir/usr/share/doc/$pkgname/README.md"
}
