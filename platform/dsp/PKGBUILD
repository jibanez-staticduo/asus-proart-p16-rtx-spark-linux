        'n1x_adsp_ipc.h' 'n1x_adsp_client.h' 'test_transport.py' 'ipc_test.c' 'protocol.md'
        'test_primary.py' 'test_lifecycle.py' 'n1x_adsp_pcm.h' 'pcm_test.c'
        'mt8901-afe-sram.h' 'test_pcm_service.py' 'test_period.py' 'test_producer.py' 'test_trigger.py'
        'test_pm.py' 'test_device_lookup.py' 'test_provider.py')
