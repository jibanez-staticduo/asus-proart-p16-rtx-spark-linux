pkgname=n1x-scp-dkms
pkgver=0.2.0
pkgrel=5
pkgdesc='NVIDIA N1X SCP firmware queries and log reader'
arch=('aarch64')
url='https://github.com/johannhartmann/asus-proart-p16-rtx-spark-linux'
license=('GPL-2.0-only')
depends=('dkms')
source=('n1x_scp.c' 'Kbuild' 'dkms.conf' 'n1x-scp.conf' 'n1x-scp.modules' 'README.md')
sha256sums=('7545baad5b4ab2019f50096aa7b4a0aed2fe9cc5677c0ff85246a2856f78fd4e'
            '75711680eb0bdbacb3ac5127df4fed12e7e45e2bd4e5a5b6829295642a161cf3'
            '027cf3cbec3b8d707a36e067935015e427ae8e292472a02cb18eed51d2293dea'
            '839e04fa00c81253a6d4093dcb2af4ad17ef85b21b884081fb6d236d8e878671'
            '22a3ae59d7a55fed69b6a04ee7c8eca5aa9ffbcae225bf49f476b980ec388d43'
            '2f1fa63bd229e8db9f8cacdf5b63d0dfefbc09328c3a9aea00b04eaab3d23427')

package() {
  local file
  for file in n1x_scp.c Kbuild dkms.conf; do
    install -Dm644 "$srcdir/$file" "$pkgdir/usr/src/n1x-scp-$pkgver/$file"
  done
  install -Dm644 "$srcdir/n1x-scp.conf" "$pkgdir/usr/lib/modprobe.d/n1x-scp.conf"
  install -Dm644 "$srcdir/n1x-scp.modules" "$pkgdir/usr/lib/modules-load.d/n1x-scp.conf"
  install -Dm644 "$srcdir/README.md" "$pkgdir/usr/share/doc/$pkgname/README.md"
}
