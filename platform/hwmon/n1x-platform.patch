diff --git c/Kconfig w/Kconfig
new file mode 100644
index 0000000..0539ce3
--- /dev/null
+++ w/Kconfig
@@ -0,0 +1,12 @@
+# SPDX-License-Identifier: GPL-2.0-only
+config SENSORS_SPBM
+	tristate "NVIDIA Spark SPBM/MTEL telemetry"
+	depends on ACPI && HAS_IOMEM && 64BIT
+	help
+	  Monitor the supported NVDA8800 and NVDA8810 SPBM/MTEL interfaces
+	  through hwmon. NVDA8800 register offsets come from ACPI. NVDA8810
+	  requires the supported MT8901 MTEL schema and platform ID.
+
+	  Supported power controls allow reductions bounded by the current
+	  firmware policy. Uncalibrated status and energy fields are exposed
+	  as raw diagnostics, without invented physical units.
