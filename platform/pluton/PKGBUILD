check() {
  cd "$srcdir"
  cc -std=c11 -Wall -Wextra -Werror -fsanitize=address,undefined -g \
    -o protocol-test protocol_test.c
  ./protocol-test
  python test_query.py
}

package() {
  local file
  for file in n1x_pluton.c n1x_pluton_protocol.h n1x_pluton_uapi.h n1x_pcbi_protocol.h Kbuild dkms.conf; do
    install -Dm644 "$srcdir/$file" "$pkgdir/usr/src/n1x-pluton-$pkgver/$file"
  done
  install -Dm644 "$srcdir/n1x-pluton.conf" "$pkgdir/usr/lib/modprobe.d/n1x-pluton.conf"
  install -Dm644 "$srcdir/n1x-pluton.modules" "$pkgdir/usr/lib/modules-load.d/n1x-pluton.conf"
  install -Dm755 "$srcdir/pluton-info.py" "$pkgdir/usr/bin/n1x-pluton-info"
  install -Dm644 "$srcdir/protocol.md" "$pkgdir/usr/share/doc/$pkgname/protocol.md"
  install -Dm644 "$srcdir/provenance.json" "$pkgdir/usr/share/doc/$pkgname/provenance.json"
}
