pkgname=n1x-pluton-dkms
pkgver=0.1.1
pkgrel=1
pkgdesc='Experimental P16 N1X ROT1 mailbox and PFI transport'
arch=('aarch64')
url='https://github.com/johannhartmann/asus-proart-p16-rtx-spark-linux'
license=('GPL-2.0-only')
depends=('dkms' 'python')
makedepends=('gcc')
source=('n1x_pluton.c' 'n1x_pluton_protocol.h' 'n1x_pluton_uapi.h' 'Kbuild' 'dkms.conf' 'pluton-info.py' 'provenance.json' 'protocol_test.c' 'n1x-pluton.conf' 'n1x-pluton.modules')
sha256sums=('760225b74a6974c5e194edfcb6caf8844a0adbe68cdf532333de2514c3dfbcd2'
            'd42a773bc1502cdd6d3f1e87a879f8031611a64dd3064ee0d41976027670ee20'
            '4abe0db883ec5390b12f4961d7f0e321c8281617c11b46f1e07a97ab9055fe67'
