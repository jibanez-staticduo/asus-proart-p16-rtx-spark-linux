[Unit]
Description=Qwen3.8-27B Unsloth NVFP4 with DFlash2 (native vLLM)
After=network-online.target

[Service]
Type=exec
EnvironmentFile=%h/.config/vllm-qwen38.env
ExecStart=%h/.local/libexec/vllm-qwen38
CPUAffinity=5 6 7 8 9 15 16 17 18 19
TimeoutStopSec=60
KillMode=control-group
Restart=no

[Install]
WantedBy=default.target
