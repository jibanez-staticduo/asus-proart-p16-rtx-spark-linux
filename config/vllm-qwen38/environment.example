VLLM_VENV=/data/ai/venvs/vllm-qwen38
VLLM_TARGET_MODEL=/data/ai/models/unsloth/Qwen3.8-27B-NVFP4-sharded
VLLM_SOURCE_MODEL=/data/ai/models/unsloth/Qwen3.8-27B-NVFP4
VLLM_DRAFT_MODEL=/data/ai/models/z-lab/Qwen3.8-27B-DFlash2
VLLM_CACHE_DIR=/data/ai/cache/vllm-qwen38-native
CUDA_HOME=/opt/cuda
OMP_NUM_THREADS=1
TORCHINDUCTOR_COMPILE_THREADS=2
VLLM_GPU_MEMORY_UTILIZATION=0.40
VLLM_MAX_MODEL_LEN=65536
VLLM_MAX_NUM_SEQS=8
VLLM_MAX_BATCHED_TOKENS=8192
VLLM_KV_CACHE_BYTES=6442450944
VLLM_SPEC_METHOD=dflash
VLLM_DRAFT_QUANTIZATION=fp8_per_tensor
VLLM_DRAFT_SAMPLE_METHOD=greedy
VLLM_NVFP4_LINEAR_CUTOFF=0
VLLM_NVFP4_SILU_CUTOFF=16
VLLM_NVFP4_AUTOTUNE=1
