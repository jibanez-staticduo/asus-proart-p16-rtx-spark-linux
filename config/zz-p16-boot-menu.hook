[Trigger]
Operation = Install
Operation = Upgrade
Type = Package
Target = linux-omarchy
Target = linux-p16-platform
Target = linux-p16-platform-*
Target = limine
Target = limine-mkinitcpio-hook
Target = mkinitcpio
Target = omarchy-settings*
Target = plymouth*

[Action]
Description = Verifying P16 Limine images and restoring the default boot policy...
When = PostTransaction
Exec = /usr/lib/p16-platform/boot-menu
