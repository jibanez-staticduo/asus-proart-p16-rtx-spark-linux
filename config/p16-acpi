#!/usr/bin/env bash
build() {
    grep -q ' T arch_alloc_acpi_tables$' "/usr/lib/modules/$KERNELVERSION/build/System.map" || {
        error 'P16 ACPI override requires the dedicated kernel allocation fix'
        return 1
    }
    # Use the live firmware DSDT: a captured DSDT embeds a boot-specific GNVS
    # physical address. The installed acpi_osi="!Windows 2022" command line
    # already supplies the SSPM _STA behavior that the old DSDT patch changed.
    add_file_early /usr/lib/firmware/acpi/p16/SSDT.aml /kernel/firmware/acpi/SSDT.aml
}
help() {
    echo 'H7607BA.300 ASUS EC/battery SSDT with the native firmware DSDT; requires acpi_osi="!Windows 2022".'
}
