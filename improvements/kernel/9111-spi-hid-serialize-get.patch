From 8c0c59ba9383dc90a6b06d0f6d5b14d815b086c2 Mon Sep 17 00:00:00 2001
From: Johann-Peter Hartmann <johannhartmann@gmail.com>
Date: Fri, 6 Nov 2026 11:32:55 +0100
Subject: [PATCH RFC 3/4] HID: spi-hid: serialize and type GET report responses

Select GET_INPUT_REPORT for input reports and accept its response type.
Hold output_lock through response validation and copying, preventing
another caller from replacing the shared reply after completion.

Fixes: 0534d05f102e ("HID: spi-hid: add spi-hid driver HID layer")
Adapted to the curated Linux 7.3 prerequisite raw-request callback; retains
zero-length rejection and the upstream serialized response copy.

---
--- a/drivers/hid/spi-hid/spi-hid-core.c
+++ b/drivers/hid/spi-hid/spi-hid-core.c
@@ -441,13 +441,11 @@
 	return __spi_hid_send_output_report(shid, report);
 }
 
-static int spi_hid_sync_request(struct spi_hid *shid,
+static int __spi_hid_sync_request(struct spi_hid *shid,
 				struct spi_hid_output_report *report)
 {
 	struct device *dev = &shid->spi->dev;
 	int error;
-
-	guard(mutex)(&shid->output_lock);
 
 	reinit_completion(&shid->output_done);
 
@@ -465,6 +463,13 @@
 		return error;
 
 	return 0;
+}
+
+static int spi_hid_sync_request(struct spi_hid *shid,
+				struct spi_hid_output_report *report)
+{
+	guard(mutex)(&shid->output_lock);
+	return __spi_hid_sync_request(shid, report);
 }
 
 /*
@@ -544,7 +549,8 @@
 		dev_err(&shid->spi->dev, "Unexpected response report\n");
 	} else {
 		if (body->input_report_type == REPORT_DESCRIPTOR_RESPONSE ||
-		    body->input_report_type == GET_FEATURE_RESPONSE) {
+		    body->input_report_type == GET_FEATURE_RESPONSE ||
+		    body->input_report_type == GET_INPUT_REPORT_RESPONSE) {
 			memcpy(shid->response->body, shid->input->body,
 			       sizeof(shid->input->body));
 			memcpy(shid->response->content, shid->input->content,
@@ -786,15 +792,14 @@
 		}
 		fallthrough;
 	case GET_FEATURE_RESPONSE:
+	case GET_INPUT_REPORT_RESPONSE:
 	case SET_FEATURE_RESPONSE:
 	case REPORT_DESCRIPTOR_RESPONSE:
 		spi_hid_response_handler(shid, &body);
 		break;
 	/*
-	 * FIXME: sending GET_INPUT and COMMAND reports not supported, thus
-	 * throw away responses to those, they should never come.
+	 * Sending COMMAND reports is not supported.
 	 */
-	case GET_INPUT_REPORT_RESPONSE:
 	case COMMAND_RESPONSE:
 		dev_err(dev, "Not a supported report type: 0x%x\n",
 			body.input_report_type);
@@ -839,7 +844,8 @@
 	return 0;
 }
 
-static int spi_hid_get_request(struct spi_hid *shid, u8 content_id)
+static int spi_hid_get_request(struct spi_hid *shid, u8 content_id, u8 rtype,
+			       u8 *buffer, size_t length)
 {
 	struct device *dev = &shid->spi->dev;
 	struct spi_hid_output_report report = {
@@ -849,8 +855,26 @@
 		.content = NULL,
 	};
 	int error;
-
-	error = spi_hid_sync_request(shid, &report);
+	size_t content_len;
+	u8 expected;
+
+	if (rtype == HID_FEATURE_REPORT) {
+		expected = GET_FEATURE_RESPONSE;
+	} else if (rtype == HID_INPUT_REPORT) {
+		report.report_type = GET_INPUT_REPORT;
+		expected = GET_INPUT_REPORT_RESPONSE;
+	} else {
+		return -EOPNOTSUPP;
+	}
+	if (!length)
+		return -EINVAL;
+
+	/* Keep the matching response private until it has been copied. Other
+	 * feature/input requests must not replace it between completion/copy.
+	 */
+	guard(mutex)(&shid->output_lock);
+
+	error = __spi_hid_sync_request(shid, &report);
 	if (error) {
 		dev_err(dev,
 			"Expected get request response not received! Error %d\n",
@@ -860,7 +884,13 @@
 		return error;
 	}
 
-	return 0;
+	if (shid->response->body[0] != expected ||
+	    shid->response->body[3] != content_id)
+		return -EPROTO;
+	content_len = min_t(size_t, length - 1, shid->response_length);
+	buffer[0] = content_id;
+	memcpy(buffer + 1, shid->response->content, content_len);
+	return content_len + 1;
 }
 
 static int spi_hid_set_request(struct spi_hid *shid, u8 *arg_buf, u16 arg_len,
@@ -1150,6 +1180,9 @@
 	struct device *dev = &spi->dev;
 	int ret;
 
+	if (!len)
+		return -EINVAL;
+
 	switch (reqtype) {
 	case HID_REQ_SET_REPORT:
 		if (buf[0] != reportnum) {
@@ -1167,16 +1200,7 @@
 		ret = len;
 		break;
 	case HID_REQ_GET_REPORT:
-		ret = spi_hid_get_request(shid, reportnum);
-		if (ret) {
-			dev_err(dev, "failed to get report\n");
-			return ret;
-		}
-
-		ret = min_t(size_t, len,
-			    (shid->response->body[1] | (shid->response->body[2] << 8)) + 1);
-		buf[0] = shid->response->body[3];
-		memcpy(&buf[1], &shid->response->content, ret);
+		ret = spi_hid_get_request(shid, reportnum, rtype, buf, len);
 		break;
 	default:
 		dev_err(dev, "invalid request type\n");
