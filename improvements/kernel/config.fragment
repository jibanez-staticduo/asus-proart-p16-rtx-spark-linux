# Merge into your distro's working N1X config, then run make olddefconfig.
CONFIG_SUSPEND=y
CONFIG_PM_SLEEP=y
CONFIG_ARM_PSCI_CPUIDLE=y
CONFIG_ARM_PSCI_CPUIDLE_DOMAIN=y
CONFIG_ACPI_PROCESSOR=y
CONFIG_ACPI_PROCESSOR_IDLE=y
CONFIG_MTK_SSPM_CI=y
CONFIG_MTK_POWER_WRAP=y
CONFIG_PINCTRL_MT8901=y
CONFIG_ACPI_WMI=m
CONFIG_ASUS_WMI=m
CONFIG_ASUS_NB_WMI=m
# CONFIG_ASUS_ARMOURY is not set
# CONFIG_ASUS_WMI_DEPRECATED_ATTRS is not set
CONFIG_SPI_HID=m
CONFIG_SPI_HID_CORE=m
CONFIG_SPI_HID_ACPI=m
CONFIG_HID_SENSOR_HUB=m
CONFIG_HID_SENSOR_IIO_COMMON=m
CONFIG_HID_SENSOR_IIO_TRIGGER=m
CONFIG_HID_SENSOR_ALS=m
CONFIG_IIO=m
