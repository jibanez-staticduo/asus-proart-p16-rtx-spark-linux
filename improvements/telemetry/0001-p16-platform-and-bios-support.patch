+/* SPDX-License-Identifier: GPL-2.0 */
+#ifndef SPBM_N1X_PROBE_POLICY_H
+#define SPBM_N1X_PROBE_POLICY_H
+
+#include <linux/types.h>
+
+static inline bool n1x_probe_has_supported_sensors(bool p16_model,
+						   bool acpi_power,
+						   bool acpi_temp,
+						   bool validated_mmio)
+{
+	return acpi_power || acpi_temp || (p16_model && validated_mmio);
+}
