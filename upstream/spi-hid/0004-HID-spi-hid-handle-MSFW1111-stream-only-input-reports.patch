Subject: [PATCH] HID: spi-hid: handle MSFW1111 stream-only input reports

The MSFW1111 sensor controller (VID 0000, PID 0100) sends DATA reports
and does not answer GET_INPUT_REPORT. Let the pending HID sensor read
complete from its DATA report and reject synchronous raw input reads.
Match the controller ACPI ID and HID vendor/product, independent of the host.

---
diff --git a/drivers/hid/spi-hid/spi-hid-core.c b/drivers/hid/spi-hid/spi-hid-core.c
index a562b5e..e92745e 100644
--- a/drivers/hid/spi-hid/spi-hid-core.c
+++ b/drivers/hid/spi-hid/spi-hid-core.c
@@ -20,6 +20,7 @@
  *  Copyright (c) 2006-2010 Jiri Kosina
  */
 
+#include <linux/acpi.h>
 #include <linux/bitfield.h>
 #include <linux/cache.h>
 #include <linux/completion.h>
@@ -770,6 +771,13 @@ static int spi_hid_create_device(struct spi_hid *shid)
 	hid->vendor = shid->desc.vendor_id;
 	hid->product = shid->desc.product_id;
 
+	/* This sensor controller supplies input through asynchronous DATA
+	 * reports. Identify the controller, independent of the host system.
+	 */
+	shid->input_stream_only = ACPI_COMPANION(dev) &&
+		acpi_dev_hid_uid_match(ACPI_COMPANION(dev), "MSFW1111", NULL) &&
+		hid->vendor == 0 && hid->product == 0x0100;
+
 	snprintf(hid->name, sizeof(hid->name), "spi %04X:%04X",
 		 hid->vendor, hid->product);
 	strscpy(hid->phys, dev_name(&shid->spi->dev), sizeof(hid->phys));
@@ -1011,6 +1019,8 @@ static int spi_hid_get_request(struct spi_hid *shid, u8 content_id, u8 rtype,
 	size_t content_len;
 	u8 expected;
 
+	if (shid->input_stream_only && rtype == HID_INPUT_REPORT)
+		return -EOPNOTSUPP;
 	if (rtype == HID_FEATURE_REPORT) {
 		expected = GET_FEATURE_RESPONSE;
 	} else if (rtype == HID_INPUT_REPORT) {
@@ -1404,6 +1414,27 @@ static int spi_hid_ll_output_report(struct hid_device *hid, __u8 *buf,
 	return len;
 }
 
+static void spi_hid_ll_request(struct hid_device *hid, struct hid_report *report,
+			       int reqtype)
+{
+	struct spi_device *spi = hid->driver_data;
+	struct spi_hid *shid = spi_get_drvdata(spi);
+	int ret;
+
+	/* SCP 2.0.8.0 routes GET_INPUT to the VEML3328 task, but that task
+	 * implements only feature commands and asynchronous data reports. The
+	 * HID sensor hub has already armed its pending-read completion; its
+	 * next DATA report supplies the real sample. Never substitute feature
+	 * configuration bytes or repeatedly reset the firmware on a timeout.
+	 */
+	if (shid->input_stream_only && reqtype == HID_REQ_GET_REPORT &&
+	    report->type == HID_INPUT_REPORT)
+		return;
+	ret = __hid_request(hid, report, reqtype);
+	if (ret < 0)
+		hid_dbg(hid, "SPI HID request failed: %d\n", ret);
+}
+
 static struct hid_ll_driver spi_hid_ll_driver = {
 	.start = spi_hid_ll_start,
 	.stop = spi_hid_ll_stop,
@@ -1413,6 +1444,7 @@ static struct hid_ll_driver spi_hid_ll_driver = {
 	.parse = spi_hid_ll_parse,
 	.output_report = spi_hid_ll_output_report,
 	.raw_request = spi_hid_ll_raw_request,
+	.request = spi_hid_ll_request,
 };
 
 static ssize_t bus_error_count_show(struct device *dev,
diff --git a/drivers/hid/spi-hid/spi-hid-core.h b/drivers/hid/spi-hid/spi-hid-core.h
index ffe3e4b..071d238 100644
--- a/drivers/hid/spi-hid/spi-hid-core.h
+++ b/drivers/hid/spi-hid/spi-hid-core.h
@@ -44,6 +44,7 @@ struct spi_hid_device_descriptor {
 
 /* Driver context */
 struct spi_hid {
+	bool input_stream_only;
 	struct spi_device	*spi;	/* spi device. */
 	struct hid_device	*hid;	/* pointer to corresponding HID dev. */
 
